{% schema %}
{
    "name": "Featured Categories",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Shop by Category"
        },
        {
            "type": "number",
            "id": "categories_to_show",
            "label": "Categories to Show",
            "default": 4
        }
    ]
}
{% endschema %}

<section class="featured-categories">
    <div class="container">
        {% if section.settings.heading %}
            <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        
        <div class="category-grid">
            {% for category in ['Electronics', 'Fashion', 'Home & Garden', 'Sports'] | slice(0, section.settings.categories_to_show) %}
                <div class="category-card">
                    <a href="/category/{{ category | lower | replace(' ', '-') }}" class="category-link">
                        <div class="category-image">
                            <img src="/images/{{ category | lower | replace(' ', '-') }}.jpg" 
                                     alt="{{ category }}" 
                                     onerror="this.src='https://via.placeholder.com/300x200?text={{ category }}'">
                        </div>
                        <h3 class="category-name">{{ category }}</h3>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
.featured-categories {
    padding: 3rem 0;
}

.section-heading {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 2rem;
    color: var(--dark);
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

.category-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.category-link {
    text-decoration: none;
    color: inherit;
    display: block;
}

.category-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
}

.category-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.category-card:hover .category-image img {
    transform: scale(1.05);
}

.category-name {
    padding: 1rem;
    text-align: center;
    font-size: 1.25rem;
    color: var(--dark);
    margin: 0;
}
</style>