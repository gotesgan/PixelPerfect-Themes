<footer class="footer section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="footer__content-top page-width">
      <div class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet">
        
        <div class="footer-block grid__item footer-block--menu">
          {% if section.settings.heading_1 != blank %}
            <h2 class="footer-block__heading">{{ section.settings.heading_1 }}</h2>
          {% endif %}
          <ul class="footer-block__details-content list-unstyled">
            {% for item in nav.header %}
              <li>
                <a href="{{ item.link }}" class="link link--text list-menu__item list-menu__item--link">
                  {{ item.name }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-block grid__item footer-block--menu">
          {% if section.settings.heading_2 != blank %}
            <h2 class="footer-block__heading">{{ section.settings.heading_2 }}</h2>
          {% endif %}
          <ul class="footer-block__details-content list-unstyled">
            {% for item in nav.footer %}
              <li>
                <a href="{{ item.link }}" class="link link--text list-menu__item list-menu__item--link">
                  {{ item.name }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-block grid__item footer-block--text">
          {% if section.settings.heading_3 != blank %}
            <h2 class="footer-block__heading">{{ section.settings.heading_3 }}</h2>
          {% endif %}
          <div class="footer-block__details-content rte">
            {{ section.settings.text }}
          </div>
        </div>

        <div class="footer-block grid__item footer-block--newsletter">
          {% if section.settings.newsletter_heading != blank %}
            <h2 class="footer-block__heading">{{ section.settings.newsletter_heading }}</h2>
          {% endif %}
          <div class="footer-block__newsletter">
            <form class="newsletter-form">
              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input 
                    id="NewsletterForm--{{ section.id }}"
                    type="email" 
                    name="contact[email]" 
                    class="field__input" 
                    value="" 
                    aria-required="true" 
                    autocorrect="off" 
                    autocapitalize="off" 
                    autocomplete="email" 
                    placeholder="Email"
                    required
                  >
                  <label class="field__label" for="NewsletterForm--{{ section.id }}">
                    Email
                  </label>
                  <button type="submit" class="newsletter-form__button field__button" name="commit" id="Subscribe" aria-label="Subscribe">
                    <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"/>
                    </svg>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="footer__content-bottom">
      <div class="footer__content-bottom-wrapper page-width">
        <div class="footer__copyright caption">
          <small class="copyright__content">&copy; {{ shop.name | default('My Store') }}. All rights reserved.</small>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--color-background);
    border-top: 1px solid var(--color-border);
  }

  .footer__content-top {
    padding-bottom: 4rem;
  }

  .footer__blocks-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 4rem;
  }

  .footer-block__heading {
    margin-bottom: 2rem;
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
  }

  .list-unstyled {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu__item--link {
    display: inline-block;
    padding-bottom: 1rem;
    color: rgba(var(--color-foreground), 0.75);
    text-decoration: none;
  }

  .list-menu__item--link:hover {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
  }

  .footer-block__details-content {
    font-size: 1.4rem;
    line-height: 1.8;
  }

  /* Newsletter Form */
  .field {
    position: relative;
    display: flex;
    width: 100%;
  }

  .field__input {
    flex-grow: 1;
    text-align: left;
    padding: 1.5rem;
    margin: 0;
    border: 1px solid var(--color-border);
    background-color: transparent;
    color: rgb(var(--color-foreground));
    font-size: 1.4rem;
  }

  .field__label {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    transition: 0.2s ease;
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.4rem;
  }

  .field__input:focus ~ .field__label,
  .field__input:not(:placeholder-shown) ~ .field__label {
    top: 0.5rem;
    font-size: 1rem;
    transform: translateY(0);
  }
  
  .field__input::placeholder {
    opacity: 0;
  }

  .field__button {
    background: transparent;
    border: none;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
  }

  .footer__content-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    margin-top: 3rem;
  }

  .footer__copyright {
    text-align: center;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "heading_1",
      "default": "Quick links",
      "label": "Heading 1"
    },
    {
      "type": "text",
      "id": "heading_2",
      "default": "Info",
      "label": "Heading 2"
    },
    {
      "type": "text",
      "id": "heading_3",
      "default": "Our Mission",
      "label": "Heading 3"
    },
    {
      "type": "textarea",
      "id": "text",
      "default": "Share contact information, store details, and brand content with your customers.",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Subscribe to our emails",
      "label": "Newsletter Heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
