<div class="featured-products section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="title-wrapper-with-link {% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %}">
      <h2 class="title {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h2>
      {% if section.settings.show_view_all and section.settings.limit < products.length %}
        <a href="/products" class="link underlined-link large-up-hide">
          View all
        </a>
      {% endif %}
    </div>

    <div class="product-grid">
      {% for product in products %}
        {% if loop.index <= section.settings.limit %}
          <div class="product-card">
            <div class="product-card__image-wrapper">
              <a href="/product/{{ product.id }}" class="product-card__link">
                {% if product.images.length > 0 %}
                  <img 
                    src="{{ product.images[0].cdnUrl }}" 
                    alt="{{ product.images[0].altText }}" 
                    class="product-card__image motion-reduce"
                    loading="lazy"
                    width="100%"
                    height="100%"
                  >
                  {% if product.images.length > 1 and section.settings.show_secondary_image %}
                    <img 
                      src="{{ product.images[1].cdnUrl }}" 
                      alt="{{ product.images[1].altText }}" 
                      class="product-card__image product-card__image--secondary motion-reduce"
                      loading="lazy"
                      width="100%"
                      height="100%"
                    >
                  {% endif %}
                {% else %}
                  <img src="https://via.placeholder.com/300" alt="{{ product.name }}" class="product-card__image" loading="lazy">
                {% endif %}
              </a>
              {% if product.productBadges.length > 0 %}
                <div class="product-card__badge">
                  <span class="badge">{{ product.productBadges[0] }}</span>
                </div>
              {% endif %}
            </div>
            
            <div class="product-card__info">
              <h3 class="product-card__title h4">
                <a href="/product/{{ product.id }}" class="link link--text">
                  {{ product.name }}
                </a>
              </h3>
              <div class="product-card__price">
                {% if product.variants.length > 0 %}
                  <span class="price-item price-item--regular">
                    ₹{{ product.variants[0].price }}
                  </span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_view_all and section.settings.limit < products.length %}
      <div class="center collection__view-all">
        <a href="/products" class="btn btn-outline" aria-label="View all products">
          View all
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  
  .title-wrapper-with-link {
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .product-card {
    position: relative;
  }
  
  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f4f4f4;
    margin-bottom: 1.5rem;
  }
  
  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }
  
  .product-card__image--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  
  .product-card:hover .product-card__image--secondary {
    opacity: 1;
  }
  
  .product-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    font-weight: 400;
  }
  
  .product-card__price {
    font-size: 1.4rem;
  }
  
  .product-card__badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
  }
  
  .badge {
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 0.4rem 1rem;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
  }
  
  .collection__view-all {
    margin-top: 4rem;
    text-align: center;
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Featured products",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Enable \"View all\" button"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
