<div class="page-width section-{{ section.id }}-padding">
  <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
    <h2 class="title {{ section.settings.heading_size }}">
      {{ section.settings.heading | escape }}
    </h2>
  </div>

  <div class="product-grid">
    {% for product in products %}
      <div class="product-card">
        <div class="product-image">
          <a href="/product/{{ product.id }}" class="full-unstyled-link">
            {% if product.images.length > 0 %}
              <img src="{{ product.images[0].cdnUrl }}" alt="{{ product.images[0].altText }}" loading="lazy">
            {% else %}
              <img src="https://via.placeholder.com/300" alt="{{ product.name }}" loading="lazy">
            {% endif %}
          </a>
          {% if product.productBadges.length > 0 %}
            <div class="card__badge bottom left">
              {% for badge in product.productBadges %}
                <span class="badge color-{{ settings.sold_out_badge_color_scheme }}">{{ badge }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        
        <div class="product-info">
          <h3 class="product-title">
            <a href="/product/{{ product.id }}" class="full-unstyled-link">
              {{ product.name }}
            </a>
          </h3>
          <div class="product-price">
            {% if product.variants.length > 0 %}
              <span class="price-item price-item--regular">
                ₹{{ product.variants[0].price }}
              </span>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ (section.settings.padding_top * 0.75) | round }}px;
    padding-bottom: {{ (section.settings.padding_bottom * 0.75) | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
  .title-wrapper-with-link {
    margin-bottom: 3rem;
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Featured products",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
