<div class="hero" style="height: {{ section.settings.section_height }}vh;" data-section-id="{{ section.id }}">
  {% if section.settings.image %}
    <img src="{{ section.settings.image }}" alt="{{ section.settings.heading }}" class="hero__image" data-setting-id="{{ section.id }}.image">
  {% else %}
    <div class="hero__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}

  <div class="hero__overlay"></div>

  <div class="hero__content {{ section.settings.desktop_content_position }}">
    <div class="hero__text-container">
      {% if section.settings.heading != blank %}
        <h2 class="hero__heading" data-setting-id="{{ section.id }}.heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="hero__text" data-setting-id="{{ section.id }}.text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="hero__button {% if section.settings.button_style == 'secondary' %}btn-secondary{% endif %}" data-setting-id="{{ section.id }}.button_text">{{ section.settings.button_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.section_height }}vh;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  
  .hero__media img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.image_overlay_opacity / 100 }});
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    pointer-events: none;
  }

  .hero__box {
    background: {{ section.settings.color_scheme_background }};
    color: {{ section.settings.color_scheme_text }};
    padding: 4rem 5rem;
    max-width: 60rem;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  /* Content Positioning */
  .content-top-left { margin: 2rem auto auto 2rem; text-align: left; }
  .content-top-center { margin: 2rem auto auto auto; text-align: center; }
  .content-top-right { margin: 2rem 2rem auto auto; text-align: right; }
  
  .content-middle-left { margin: auto auto auto 2rem; text-align: left; }
  .content-middle-center { margin: auto; text-align: center; }
  .content-middle-right { margin: auto 2rem auto auto; text-align: right; }
  
  .content-bottom-left { margin: auto auto 2rem 2rem; text-align: left; }
  .content-bottom-center { margin: auto auto 2rem auto; text-align: center; }
  .content-bottom-right { margin: auto 2rem 2rem auto; text-align: right; }

  .hero__heading {
    margin: 0;
    color: inherit;
  }

  .hero__text {
    font-size: 1.8rem;
    color: inherit;
  }
  
  .large-text p {
    font-size: 1.2em;
  }

  @media (max-width: 768px) {
    .hero { min-height: 50vh; }
    .hero__box { 
      width: 100%; 
      max-width: 100%; 
      margin: auto 0 0 0 !important; 
      padding: 3rem 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Give customers details about the banner image(s) or content on the template."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/products"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 60
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Desktop content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "color",
      "id": "color_scheme_background",
      "label": "Content Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "color_scheme_text",
      "label": "Content Text",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
