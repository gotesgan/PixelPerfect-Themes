{% extends "layouts/layout.psp" %}

{% block content %}
  <section class="product-section section">
    <div class="page-width">
      <div class="product-grid-layout">
        <!-- Product Media -->
        <div class="product-media-wrapper">
          <div class="product-media-gallery">
            {% if product.images.length > 0 %}
              <div class="product-media-main">
                <img id="MainImage" src="{{ product.images[0].cdnUrl }}" alt="{{ product.images[0].altText }}" class="product-media-image">
              </div>
              {% if product.images.length > 1 %}
                <div class="product-media-thumbnails">
                  {% for image in product.images %}
                    <button class="thumbnail-button {% if loop.first %}active{% endif %}" onclick="updateMainImage('{{ image.cdnUrl }}', this)">
                      <img src="{{ image.cdnUrl }}" alt="{{ image.altText }}">
                    </button>
                  {% endfor %}
                </div>
              {% endif %}
            {% else %}
              <div class="product-media-main placeholder">
                <img src="https://via.placeholder.com/600" alt="Placeholder" style="width:100%;height:100%;object-fit:cover;">
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info-wrapper">
          <div class="product-info-container">
            <div class="product-vendor text-uppercase text-subdued">{{ product.vendor | default('Vendor') }}</div>
            
            <h1 class="product-title h2">{{ product.name }}</h1>
            
            <div class="product-price-wrapper">
              {% if product.variants.length > 0 %}
                <span class="price-item price-item--regular h4">
                  ₹{{ product.variants[0].price }}
                </span>
              {% endif %}
            </div>

            {% if product.description %}
              <div class="product-description rte">
                {{ product.description }}
              </div>
            {% endif %}

            <form action="/cart/add" method="post" class="product-form">
              <input type="hidden" name="id" value="{{ product.variants[0].id }}">
              
              {% if product.options.length > 0 %}
                <div class="product-options">
                  {% for option in product.options %}
                    <div class="product-option">
                      <label class="product-option-label">{{ option.name }}</label>
                      <div class="product-option-values">
                        {% for value in option.values %}
                          <label class="option-value-label">
                            <input type="radio" name="option-{{ option.name }}" value="{{ value.value }}" {% if loop.first %}checked{% endif %}>
                            <span class="option-value-text">{{ value.value }}</span>
                          </label>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="product-quantity">
                <label for="Quantity" class="quantity-label">Quantity</label>
                <div class="quantity-input-wrapper">
                  <button type="button" class="quantity-button" onclick="adjustQuantity(-1)">-</button>
                  <input type="number" name="quantity" id="Quantity" value="1" min="1" class="quantity-input">
                  <button type="button" class="quantity-button" onclick="adjustQuantity(1)">+</button>
                </div>
              </div>

              <div class="product-form-buttons">
                <button type="submit" class="btn btn-primary btn-full">Add to cart</button>
                <button type="button" class="btn btn-secondary btn-full">Buy it now</button>
              </div>
            </form>

            <div class="product-accordions">
              <details class="accordion">
                <summary class="accordion__title">
                  <span>Description</span>
                  <svg class="icon icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="accordion__content rte">
                  {{ product.description }}
                </div>
              </details>
              
              <details class="accordion">
                <summary class="accordion__title">
                  <span>Shipping & Returns</span>
                  <svg class="icon icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="accordion__content rte">
                  <p>Free shipping on all orders over ₹999. Returns accepted within 30 days.</p>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .product-grid-layout {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 6rem;
    }

    /* Media */
    .product-media-main {
      margin-bottom: 2rem;
      background: #f4f4f4;
      overflow: hidden;
    }

    .product-media-image {
      width: 100%;
      height: auto;
      display: block;
    }

    .product-media-thumbnails {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1rem;
    }

    .thumbnail-button {
      border: 1px solid transparent;
      padding: 0;
      background: none;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    .thumbnail-button.active {
      border-color: var(--color-foreground);
    }

    .thumbnail-button img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      aspect-ratio: 1;
    }

    /* Info */
    .product-info-container {
      position: sticky;
      top: 10rem;
    }

    .product-vendor {
      font-size: 1.2rem;
      letter-spacing: 0.1rem;
      margin-bottom: 1rem;
    }

    .product-title {
      margin-bottom: 1.5rem;
    }

    .product-price-wrapper {
      margin-bottom: 2rem;
    }

    .product-description {
      margin-bottom: 3rem;
      color: rgba(var(--color-foreground), 0.75);
    }

    /* Form */
    .product-form {
      margin-bottom: 3rem;
    }

    .product-option {
      margin-bottom: 2rem;
    }

    .product-option-label {
      display: block;
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    .option-value-label {
      display: inline-block;
      margin-right: 1rem;
      cursor: pointer;
    }

    .option-value-label input {
      display: none;
    }

    .option-value-text {
      display: inline-block;
      padding: 0.8rem 2rem;
      border: 1px solid var(--color-border);
      border-radius: 2rem;
      font-size: 1.4rem;
      transition: all 0.2s;
    }

    .option-value-label input:checked + .option-value-text {
      background: var(--color-foreground);
      color: var(--color-background);
      border-color: var(--color-foreground);
    }

    .product-quantity {
      margin-bottom: 3rem;
    }

    .quantity-input-wrapper {
      display: inline-flex;
      border: 1px solid var(--color-border);
    }

    .quantity-button {
      background: none;
      border: none;
      padding: 1rem 1.5rem;
      cursor: pointer;
      font-size: 1.6rem;
    }

    .quantity-input {
      width: 5rem;
      text-align: center;
      border: none;
      border-left: 1px solid var(--color-border);
      border-right: 1px solid var(--color-border);
      -moz-appearance: textfield;
    }

    .product-form-buttons {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .btn-full {
      width: 100%;
    }

    /* Accordions */
    .accordion {
      border-top: 1px solid var(--color-border);
    }

    .accordion:last-child {
      border-bottom: 1px solid var(--color-border);
    }

    .accordion__title {
      padding: 1.5rem 0;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 500;
    }

    .accordion__title::-webkit-details-marker {
      display: none;
    }

    .accordion__content {
      padding-bottom: 1.5rem;
      color: rgba(var(--color-foreground), 0.75);
    }

    @media (max-width: 768px) {
      .product-grid-layout {
        grid-template-columns: 1fr;
        gap: 3rem;
      }

      .product-info-container {
        position: static;
      }
    }
  </style>

  <script>
    function updateMainImage(src, btn) {
      document.getElementById('MainImage').src = src;
      document.querySelectorAll('.thumbnail-button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    function adjustQuantity(delta) {
      const input = document.getElementById('Quantity');
      const newValue = parseInt(input.value) + delta;
      if (newValue >= 1) input.value = newValue;
    }
  </script>
{% endblock %}
