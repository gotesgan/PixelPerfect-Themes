{% extends "layouts/layout.psp" %}

{% block content %}
  <div class="collection-hero section">
    <div class="page-width text-center">
      <h1 class="collection-hero__title h1">
        {% if currentCategory %}
          {% for cat in categories %}
            {% if cat.id == currentCategory %}{{ cat.name }}{% endif %}
          {% endfor %}
        {% else %}
          All Products
        {% endif %}
      </h1>
      <div class="collection-hero__description rte">
        <p>Explore our wide range of quality products</p>
      </div>
    </div>
  </div>

  <div class="page-width section">
    <div class="facets-container">
      <div class="facets-wrapper">
        <div class="facets-header">
          <span class="facets-count">{{ products.length }} products</span>
          <div class="facets-sorting">
            <label for="SortBy">Sort by:</label>
            <select name="sort_by" id="SortBy" class="facets-sort-select">
              <option value="featured">Featured</option>
              <option value="price-ascending">Price: Low to High</option>
              <option value="price-descending">Price: High to Low</option>
            </select>
          </div>
        </div>
        
        <div class="active-facets">
          <a href="/products" class="active-facets__button {% if not currentCategory %}active-facets__button--active{% endif %}">All</a>
          {% for category in categories %}
            <a href="/products?category={{ category.id }}" class="active-facets__button {% if currentCategory == category.id %}active-facets__button--active{% endif %}">
              {{ category.name }}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>

    {% if products.length == 0 %}
      <div class="collection collection--empty page-width text-center">
        <div class="title-wrapper center">
          <h2 class="title title--primary">No products found</h2>
          <p>Try changing your filters or check back later.</p>
          <a href="/products" class="btn btn-primary">Clear all</a>
        </div>
      </div>
    {% else %}
      <div class="product-grid">
        {% for product in products %}
          <div class="product-card">
            <div class="product-card__image-wrapper">
              <a href="/product/{{ product.id }}" class="product-card__link">
                {% if product.images.length > 0 %}
                  <img 
                    src="{{ product.images[0].cdnUrl }}" 
                    alt="{{ product.images[0].altText }}" 
                    class="product-card__image motion-reduce"
                    loading="lazy"
                    width="100%"
                    height="100%"
                  >
                  {% if product.images.length > 1 %}
                    <img 
                      src="{{ product.images[1].cdnUrl }}" 
                      alt="{{ product.images[1].altText }}" 
                      class="product-card__image product-card__image--secondary motion-reduce"
                      loading="lazy"
                      width="100%"
                      height="100%"
                    >
                  {% endif %}
                {% else %}
                  <img src="https://via.placeholder.com/300" alt="{{ product.name }}" class="product-card__image" loading="lazy">
                {% endif %}
              </a>
              {% if product.productBadges.length > 0 %}
                <div class="product-card__badge">
                  <span class="badge">{{ product.productBadges[0] }}</span>
                </div>
              {% endif %}
            </div>
            
            <div class="product-card__info">
              <h3 class="product-card__title h4">
                <a href="/product/{{ product.id }}" class="link link--text">
                  {{ product.name }}
                </a>
              </h3>
              <div class="product-card__price">
                {% if product.variants.length > 0 %}
                  <span class="price-item price-item--regular">
                    ₹{{ product.variants[0].price }}
                  </span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    .collection-hero {
      padding: 4rem 0;
      background-color: #f4f4f4;
      margin-bottom: 4rem;
    }

    .facets-container {
      margin-bottom: 3rem;
    }

    .facets-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    .facets-sort-select {
      border: none;
      background: transparent;
      font-family: inherit;
      font-size: 1.4rem;
      cursor: pointer;
    }

    .active-facets {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .active-facets__button {
      padding: 0.6rem 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 2rem;
      font-size: 1.3rem;
      text-decoration: none;
      color: var(--color-foreground);
      transition: all 0.2s;
    }

    .active-facets__button:hover,
    .active-facets__button--active {
      background-color: var(--color-foreground);
      color: var(--color-background);
      border-color: var(--color-foreground);
    }

    /* Reuse product card styles from featured-products or theme.css */
    .product-card {
      position: relative;
    }
    
    .product-card__image-wrapper {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background-color: #f4f4f4;
      margin-bottom: 1.5rem;
    }
    
    .product-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity 0.4s ease;
    }
    
    .product-card__image--secondary {
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0;
    }
    
    .product-card:hover .product-card__image--secondary {
      opacity: 1;
    }
    
    .product-card__title {
      margin: 0 0 0.5rem;
      font-size: 1.5rem;
      font-weight: 400;
    }
    
    .product-card__price {
      font-size: 1.4rem;
    }
    
    .product-card__badge {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
    }
    
    .badge {
      background: var(--color-foreground);
      color: var(--color-background);
      padding: 0.4rem 1rem;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.1rem;
    }
  </style>
{% endblock %}
