<header class="header">
    <nav class="navbar">
        <a href="/" class="logo">
            {% if shop.displayMode == 'logo' or shop.displayMode == 'both' %}
                <img src="{{ shop.logo }}" alt="{{ shop.name }}">
                {% endif %}
                {% if shop.displayMode == 'name' or shop.displayMode == 'both' %}
                    <span>{{ shop.name }}</span>
                {% endif %}
            </a>
            <ul class="nav-links">
                {% for item in nav.header %}
                    <li>
                        <a href="{{ item.link }}">{{ item.name }}</a>
                    </li>
                {% endfor %}
            </ul>
            <div class="nav-actions">
                <a href="/cart" class="cart-icon">
                    🛒
                    <span class="cart-count">0</span>
                </a>
            </div>
        </nav>
    </header>