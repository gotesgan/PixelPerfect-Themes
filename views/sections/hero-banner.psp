<section class="hero">
    <div class="hero-background" style="background-image: url('{{ section.settings.background_image | default('https://media.pixelperfects.in/1763190357502-1.jpg') }}');"></div>
    <div class="hero-content">
        <h1>{{ section.settings.heading | default("Welcome to Our Store") }}</h1>
        <a href="{{ section.settings.button_link | default('/products') }}" class="btn btn-white btn-lg">{{ section.settings.button_text | default("Shop Now") }}</a>
    </div>
</section>


{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to Our Store"
    },
    {
      "type": "image",
      "id": "background_image",
      "label": "Background Image",
      "default": "https://media.pixelperfects.in/1763190357502-1.jpg"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/products"
    }
  ]
}
{% endschema %}