{% extends "layout.psp" %}
{% block content %}
    <div class="hero">
        <h2>{{ title }}</h2>
        <p>{{ message }}</p>
        <a href="/about" class="btn">Learn More</a>
    </div>
    <section class="features">
        <h3>Features</h3>
        <ul>
            <li>Express.js web framework</li>
            <li>Nunjucks templating engine</li>
            <li>Server-side rendering</li>
            <li>Static file serving</li>
        </ul>
    </section>
{% endblock %}