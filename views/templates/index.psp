{% extends "layouts/layout.psp" %}
{% block content %}
    {% if heroGroup %}
        {% for sectionId in heroGroup.order %}
            {% set section = heroGroup.sections[sectionId] %}
            {% include "sections/" + section.type + ".psp" ignore missing %}
        {% endfor %}
    {% endif %}

    {% include "sections/featured-categories.psp" %}
    {% include "sections/featured-products.psp" %}
{% endblock %}