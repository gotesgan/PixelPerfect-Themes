{% extends "layouts/layout.psp" %}
{% block content %}
    <div class="page-header text-center">
        <h1>All Products</h1>
        <p>Explore our wide range of quality products</p>
    </div>
    <div class="flex flex-wrap gap-2 mb-4 justify-between items-center">
        <div class="flex gap-1">
            <a href="/products" class="btn {% if not currentCategory %}btn-primary{% else %}btn-secondary{% endif %} btn-sm">All</a>
            {% for category in categories %}
                <a
                    href="/products?category={{ category.id }}"
                    class="btn {% if currentCategory == category.id %}btn-primary{% else %}btn-secondary{% endif %} btn-sm">{{ category.name }}</a>
            {% endfor %}
        </div>
        <div>
            <span class="text-gray-500">{{ products.length }} products found</span>
        </div>
    </div>
    {% if products.length == 0 %}
        <div class="text-center py-5">
            <h3>No products found</h3>
            <p>Try changing your filter or check back later.</p>
            <a href="/products" class="btn btn-primary mt-2">Clear Filters</a>
        </div>
    {% else %}
        <div class="product-grid">
            {% for product in products %}
                <div class="product-card">
                    <div class="product-image">
                        {% if product.images.length > 0 %}
                            <img src="{{ product.images[0].cdnUrl }}" alt="{{ product.images[0].altText }}">
                            {% else %}
                                <img src="https://via.placeholder.com/300" alt="{{ product.name }}">
                                {% endif %}
                                {% if product.productBadges.length > 0 %}
                                    <div class="product-badges">
                                        {% for badge in product.productBadges %}
                                            <span class="badge {% if badge == 'New Arrival' %}badge-new{% elif badge == 'Best Seller' %}badge-bestseller{% else
                                                %}badge-sale{% endif %}">{{ badge }}</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="product-info">
                                <div class="product-category">
                                    {% for cat in categories %}
                                        {% if cat.id == product.category_id %}
                                            {{ cat.name }}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <h3 class="product-title">{{ product.name }}</h3>
                                <div class="product-price">
                                    {% if product.variants.length > 0 %}
                                        <span class="price-current">₹{{ product.variants[0].price }}</span>
                                    {% endif %}
                                </div>
                                <div class="product-actions">
                                    <a href="/product/{{ product.id }}" class="btn btn-primary btn-sm">View</a>
                                    <button class="btn btn-outline btn-sm">Add to Cart</button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endblock %}