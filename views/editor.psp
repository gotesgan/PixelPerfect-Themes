<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theme Editor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { height: 100vh; overflow: hidden; }
        .editor-sidebar { width: 400px; background: #f8f9fa; border-right: 1px solid #dee2e6; display: flex; flex-direction: column; height: 100%; }
        .editor-main { flex: 1; background: #e9ecef; padding: 20px; display: flex; flex-direction: column; }
        .preview-frame { flex: 1; width: 100%; border: none; background: white; box-shadow: 0 0 20px rgba(0,0,0,0.1); border-radius: 8px; }
        .editor-header { padding: 15px; border-bottom: 1px solid #dee2e6; background: white; display: flex; justify-content: space-between; align-items: center; }
        .editor-content { flex: 1; overflow-y: auto; padding: 15px; }
        .section-item { background: white; border: 1px solid #dee2e6; padding: 10px; margin-bottom: 10px; border-radius: 4px; cursor: pointer; }
        .section-item:hover { border-color: #0d6efd; }
        .section-item.active { border-color: #0d6efd; background-color: #e7f1ff; }
    </style>
</head>
<body>
    <div class="d-flex h-100">
        <!-- Sidebar -->
        <div class="editor-sidebar">
            <div class="editor-header">
                <h5 class="m-0">Theme Editor</h5>
                <button id="saveBtn" class="btn btn-primary btn-sm">Save</button>
            </div>
            <div class="p-3 border-bottom">
                <select id="configSelect" class="form-select">
                    {% for file in configFiles %}
                        <option value="{{ file }}" {% if file == currentFile %}selected{% endif %}>{{ file }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="editor-content">
                <div id="json-editor-holder"></div>
            </div>
        </div>

        <!-- Main Preview -->
        <div class="editor-main">
            <iframe src="/" class="preview-frame" id="previewFrame"></iframe>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@json-editor/json-editor@latest/dist/jsoneditor.min.js"></script>
    <script>
        const schemas = {{ schemas | dump | safe }};
        const configData = {{ configData | dump | safe }};
        const currentFile = "{{ currentFile }}";

        // Initialize JSON Editor
        const element = document.getElementById('json-editor-holder');
        
        // Construct a schema for the config file
        // We want to edit 'sections' and 'order'
        // But to make it user friendly, we might want a custom structure.
        // For simplicity, let's just edit the raw JSON structure but with schema validation for sections.
        
        const editorSchema = {
            type: "object",
            title: "Configuration",
            properties: {
                sections: {
                    type: "object",
                    title: "Sections",
                    additionalProperties: {
                        type: "object",
                        properties: {
                            type: {
                                type: "string",
                                enum: Object.keys(schemas)
                            },
                            settings: {
                                type: "object",
                                title: "Settings",
                                properties: {} // This needs to be dynamic based on type
                            }
                        }
                    }
                },
                order: {
                    type: "array",
                    title: "Section Order",
                    format: "table",
                    items: {
                        type: "string"
                    }
                }
            }
        };

        // Inject specific settings schemas
        // Note: JSON Editor doesn't support dynamic schema switching easily without 'oneOf'
        // So we will use a simplified approach: Just show the JSON for now, 
        // OR we can try to map it.
        
        // Let's try to make 'settings' a oneOf of all possible schemas
        const settingsOneOf = [];
        Object.keys(schemas).forEach(key => {
            const sectionSchema = schemas[key];
            const props = {};
            
            if (sectionSchema.settings) {
                sectionSchema.settings.forEach(setting => {
                    let type = "string";
                    let format = undefined;
                    
                    if (setting.type === "text") type = "string";
                    if (setting.type === "number") type = "number";
                    if (setting.type === "checkbox") type = "boolean";
                    if (setting.type === "color") { type = "string"; format = "color"; }
                    if (setting.type === "image_picker") { type = "string"; format = "url"; }
                    if (setting.type === "url") { type = "string"; format = "url"; }
                    
                    props[setting.id] = {
                        type: type,
                        title: setting.label,
                        default: setting.default,
                        format: format
                    };
                });
            }
            
            // We can't easily link 'type' to 'settings' schema in a generic object map in JSON Schema 
            // without complex 'if/then/else' logic which json-editor might not fully support or is complex to generate.
            // For this MVP, we will use a generic object for settings, but provide the schemas for reference.
        });

        const editor = new JSONEditor(element, {
            schema: editorSchema,
            startval: configData,
            theme: 'bootstrap5',
            iconlib: 'fontawesome5',
            disable_edit_json: false,
            disable_properties: false
        });

        // Handle Save
        document.getElementById('saveBtn').addEventListener('click', () => {
            const value = editor.getValue();
            
            fetch('/editor/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    file: currentFile,
                    data: value
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    document.getElementById('previewFrame').contentWindow.location.reload();
                    alert('Saved!');
                } else {
                    alert('Error saving');
                }
            });
        });

        // Handle File Switch
        document.getElementById('configSelect').addEventListener('change', (e) => {
            window.location.href = '/editor?file=' + e.target.value;
        });
    </script>
</body>
</html>
